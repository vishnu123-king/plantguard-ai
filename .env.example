APP_NAME="PlantGuard AI"
ENVIRONMENT=development
PORT=3000

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# SIH26131 Layer 2 External Providers
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrisentinel

MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000
